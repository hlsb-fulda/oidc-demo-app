{% if access_token %}
    {% if access_token.header %}
        <div class="mb-4">
            <h6 class="fw-semibold text-muted text-uppercase">
                Header
            </h6>

            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0">
                    <tbody>
                    {% for k, v in access_token.header.items() %}
                        <tr>
                            <td class="claim-key" style="width:100px">{{ k }}</td>
                            <td class="claim-value font-monospace" style="font-size:.8rem">{{ v }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}

    <div class="mb-4">
        <h6 class="fw-semibold text-muted text-uppercase d-flex align-items-center gap-2">
            Claims
            <span class="badge text-bg-warning text-dark fw-normal ms-1">
                <i class="bi bi-exclamation-triangle-fill me-1"></i>Displayed without signature verification
            </span>
        </h6>

        {{ claims_table(access_token.payload) }}
    </div>

{% else %}
    <div class="alert alert-info d-flex align-items-start gap-2 mb-4" role="alert">
        <i class="bi bi-info-circle-fill flex-shrink-0 mt-1"></i>
        <div>
            <strong>Opaque access token</strong> — this token is not a JWT and cannot be decoded locally.
            Use the
            <button class="btn btn-link btn-sm p-0 align-baseline"
                    onclick="document.getElementById('tab-introspect').click()">Introspection
            </button>
            tab
            to fetch details from the provider.
        </div>
    </div>
{% endif %}

{{ raw_section("Signature", access_token.signature, "access-token-sig", "token-block") }}

{{ raw_section("Raw Token", token.access_token, "access-token-raw", "token-block") }}