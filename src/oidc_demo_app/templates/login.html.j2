{% extends "base.html.j2" %}

{% block title %}Sign In{% endblock %}

{% block content %}
    <div class="d-flex justify-content-center align-items-start pt-5">
        <div class="login-card card shadow-sm w-50">
            <div class="card-body p-4 p-md-5">

                <div class="text-center mb-4">
                    <div class="login-brand-icon mb-2">
                        <i class="bi bi-shield-lock-fill"></i>
                    </div>
                    <h1 class="h4 fw-bold mb-1">Sign in</h1>
                    <p class="text-muted small mb-0">Choose your identity provider to continue</p>
                </div>

                {% if providers %}
                    <div class="d-grid gap-2">
                        {% for (key, provider) in providers.items() %}
                            <a href="{{ url_for("login_redirect", provider=key) }}" class="btn provider-btn d-flex align-items-center gap-3">
                                <span class="btn-icon">
                                    <i class="bi {{ provider.display_icon }}"></i>
                                </span>

                                <span>Continue with <strong>{{ provider.display_name }}</strong></span>
                                <i class="bi bi-arrow-right ms-auto text-muted small"></i>
                            </a>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="alert alert-warning d-flex align-items-center gap-2" role="alert">
                        <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                        <div>
                            No providers configured.
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}